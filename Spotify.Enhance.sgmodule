#!url=https://raw.githubusercontent.com/inderiva/sgmodule/master/Spotify.Enhance.sgmodule
#!name=Spotify (iOS 15+)
#!desc=Spotify 去广告与部分 Premium 功能；音质不支持 Very High

# Based on https://github.com/app2smile/rules/blob/master/module/spotify.module
# Force all Spotify APIs off QUIC so Shadowrocket can MITM them consistently.

[Rule]
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,UDP)),REJECT
DOMAIN,aet.spotify.com,REJECT

[Header Rewrite]
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$ header-del if-none-match

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *spclient.spotify.com

[Script]
spotify-json = type=http-request,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/,requires-body=0,script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/spotify-json.js
spotify-proto = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(\?.*)?$,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/Spotify/spot-proto-ev3.js,script-update-interval=0
